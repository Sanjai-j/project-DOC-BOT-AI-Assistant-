{
  "name": "@docbot/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:setup": "tsx src/scripts/db-setup.ts",
    "seed": "tsx src/scripts/seed.ts",
    "doctors:import": "tsx src/scripts/doctors-import.ts",
    "db:sql": "tsx src/scripts/db-sql.ts",
    "db:serve": "tsx src/scripts/db-serve.ts",
    "kb:import": "tsx src/scripts/kb-import.ts",
    "kb:text-import": "tsx src/scripts/kb-text-import.ts",
    "kb:triage-import": "tsx src/scripts/kb-triage-import.ts",
    "kb:eval": "tsx src/scripts/kb-eval.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@electric-sql/pglite-socket": "0.0.20",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
