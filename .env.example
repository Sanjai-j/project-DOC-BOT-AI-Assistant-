# ─────────────────────────────────────────────────────────────
# DocBot TeleMed — environment variables
# Copy to .env (root) — the server also reads server/.env
# Works with ZERO secrets: DB falls back to embedded Postgres,
# DocBot falls back to a built-in rule engine, maps use stored coords.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Auth — CHANGE IN PRODUCTION (openssl rand -hex 48)
JWT_SECRET=dev-only-secret-change-me
OTP_EXPIRY_MINUTES=10
# Demo admin account (development only)
ADMIN_EMAIL=admin@docbot.dev
ADMIN_PASSWORD=ChangeMe!123

# Database — leave empty to use the embedded local Postgres (PGlite, zero setup)
# Supabase / Postgres example: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# DocBot AI (optional) — without a key DocBot uses the built-in rule engine
# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Together, Ollama...
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Maps (optional) — without a key the app uses stored coordinates + OpenStreetMap
GOOGLE_MAPS_API_KEY=

# Emergency number (application setting; admin can change it in Settings)
DEFAULT_EMERGENCY_NUMBER=112
